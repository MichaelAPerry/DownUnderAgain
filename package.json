{
  "name": "down-under-again",
  "private": true,
  "version": "0.1.0",
  "description": "A retro pixel-art ecosystem survival game set along Florida's river-to-sea transect.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.e2e.json",
    "test": "vitest run",
    "check": "npm run typecheck && vitest run",
    "e2e": "playwright test"
  },
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "1.56.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "22.20.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.3.0"
  }
}
